{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Viewer",
  "version": "0.1.0",
  "identifier": "com.jorgeagar.markdownviewer",
  "build": {
    "beforeDevCommand": "pnpm watch:frontend",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Markdown Viewer",
        "width": 960,
        "height": 760,
        "minWidth": 400,
        "minHeight": 320,
        "backgroundColor": "#faf9f6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Abre y lee archivos Markdown.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown",
        "description": "Documento Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ],
    "macOS": { "minimumSystemVersion": "10.15" },
    "linux": {
      "deb": { "desktopTemplate": "../assets/markdown-viewer.desktop" },
      "rpm": { "desktopTemplate": "../assets/markdown-viewer.desktop" }
    }
  }
}
